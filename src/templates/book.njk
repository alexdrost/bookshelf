{% extends "_layout.njk" %}
{% block content %}
    {# SESSION 3 Step 1. Deliberately reuses the book modal's own classes — .mhead,
       .mcov, .mintro, .msum, .mcore, .rrow, .msec-h — so the page is that design
       given a URL, not a new treatment. #}
    <article class="sheet booksheet">
      <div class="mhead">
        <div class="mcov">
          {% if book.hasCover %}<img src="/covers/{{ book.id }}.jpg" width="170" height="255" alt="{{ book.title }} by {{ book.author }}" loading="lazy">
          {% else %}<div class="ph"><div class="t">{{ book.title }}</div><div class="a">{{ book.author }}</div></div>{% endif %}
        </div>
        <div class="mintro">
          <h1>{{ book.title }}</h1>
          {% if book.standout %}<span class="standout-badge"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.06 6.6.78-4.9 4.5 1.3 6.56L12 17.9 6.1 20.9l1.3-6.56-4.9-4.5 6.6-.78z"/></svg>Standout read</span>{% endif %}
          <p class="by">by {{ book.author }}</p>
          {# Goodreads / Amazon / Audible. Same small treatment the Goodreads link has
             always had — a brand glyph and a short label, not a button. Each one renders
             ONLY when tools/store-links.mjs could build it from real data, so the row is
             one, two or three links and never a dead one. Audible is blank on most books
             until the ASINs are filled in; that is the intended state, not a bug. #}
          <div class="blinks">
            {% if book.links.goodreads %}<a class="glink" href="{{ book.links.goodreads }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M11.43 23.94c-2.16-.1-4-1.05-4.92-2.74-.36-.66-.5-1.2-.5-1.9h2.2c.07.5.18.84.42 1.2.55.83 1.5 1.28 2.85 1.3 2.2.03 3.5-1.36 3.5-3.84v-2.2c-.78 1.3-2.1 2-3.86 2-3.1 0-5.2-2.46-5.2-6.13 0-3.74 2.12-6.3 5.27-6.3 1.76 0 3.06.74 3.8 2.04V5.1h2.13v13.06c0 3.7-2.16 5.86-5.7 5.78h.01zm.32-7.97c2.1 0 3.46-1.8 3.46-4.4 0-2.62-1.37-4.43-3.45-4.43-2.13 0-3.42 1.74-3.42 4.43 0 2.7 1.3 4.4 3.4 4.4z"/></svg>Goodreads</a>{% endif %}
            {% if book.links.amazon %}<a class="glink" href="{{ book.links.amazon }}" target="_blank" rel="noopener noreferrer nofollow"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M.92 18.3c.2-.33.53-.35.98-.07a19.6 19.6 0 0 0 10.2 2.72 20.3 20.3 0 0 0 7.4-1.53l.4-.17c.17-.08.3-.13.38-.16.3-.12.54-.06.7.17.17.23.12.44-.14.63-.35.25-.79.55-1.33.88a16.4 16.4 0 0 1-8.5 2.27 16.5 16.5 0 0 1-9.9-3.3c-.26-.2-.3-.42-.19-.65zm6.3-6.24c0-.93.23-1.72.69-2.38.46-.66 1.09-1.16 1.9-1.5a9.3 9.3 0 0 1 2.3-.6c.3-.04.78-.09 1.45-.15v-.56c0-.7-.08-1.18-.23-1.42-.23-.33-.6-.5-1.1-.5h-.14c-.37.04-.69.16-.96.37-.27.2-.44.49-.52.85-.04.23-.16.36-.34.39l-2-.25c-.2-.04-.3-.15-.3-.32 0-.03 0-.08.02-.13.2-1.03.68-1.8 1.45-2.3A5.9 5.9 0 0 1 12.1 3h.52c1.26 0 2.25.33 2.96.98.11.12.21.24.3.38.1.13.17.25.22.35.05.1.1.25.14.44.04.2.07.33.09.4.02.08.03.23.04.46v6.42c0 .19.03.36.08.5.06.16.11.27.16.34l.26.33c.13.16.2.28.2.36 0 .1-.05.18-.14.25-.95.83-1.47 1.28-1.55 1.35-.13.1-.3.11-.48.03a4.8 4.8 0 0 1-.4-.37l-.24-.26-.25-.33-.19-.26c-.52.57-1.03.93-1.53 1.08-.31.1-.7.14-1.16.14-.71 0-1.3-.22-1.75-.66-.46-.44-.69-1.07-.69-1.87zm2.86-.33c0 .36.09.64.27.86.18.21.42.32.73.32l.1-.01.13-.02c.4-.1.7-.37.93-.78.1-.19.19-.39.24-.6.06-.22.09-.4.1-.54l.01-.6V9.9c-.5 0-.89.03-1.15.1-.76.21-1.14.7-1.14 1.47l-.22.26zm8.1 7.78c.03-.05.07-.1.13-.15.35-.23.69-.4 1.01-.48.53-.13 1.05-.2 1.56-.23.14-.01.27 0 .4.02.64.06 1.03.17 1.16.33.06.08.09.2.09.35v.14c0 .46-.13 1-.38 1.63-.25.62-.6 1.13-1.04 1.51-.07.06-.13.08-.18.08l-.1-.02c-.08-.04-.1-.11-.06-.22.47-1.1.7-1.87.7-2.3 0-.14-.02-.24-.08-.3-.13-.15-.5-.23-1.1-.23-.23 0-.49.02-.8.05-.33.04-.63.09-.9.13-.08 0-.13-.01-.16-.04-.02-.03-.03-.05-.02-.07 0-.01 0-.04.02-.07l-.25-.13z"/></svg>Amazon</a>{% endif %}
            {% if book.links.audible %}<a class="glink" href="{{ book.links.audible }}" target="_blank" rel="noopener noreferrer nofollow"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 3.2A8.3 8.3 0 0 0 3.7 11.5v5a1 1 0 0 0 2 0v-5a6.3 6.3 0 0 1 12.6 0v5a1 1 0 0 0 2 0v-5A8.3 8.3 0 0 0 12 3.2z"/><rect x="3" y="13.4" width="3.6" height="7.4" rx="1.8"/><rect x="17.4" y="13.4" width="3.6" height="7.4" rx="1.8"/></svg>Audible</a>{% endif %}
          </div>

          <div class="mthemes">
            {% for t in themeLinks %}<a class="mtheme" href="/themes/{{ t.slug }}">{{ t.name }}</a>{% endfor %}
          </div>
          {% if book.summary %}<p class="msum">{{ book.summary | fmt | safe }}</p>{% endif %}
        </div>
      </div>

      <div class="mbody">
        {% if book.core and book.core.length %}
        <div class="msec-h">Core ideas</div>
        <ul class="mcore">{% for c in book.core %}<li>{{ c | fmt | safe }}</li>{% endfor %}</ul>
        {% endif %}

        {% if book.standoutNote %}
        <blockquote class="standout-quote">{{ book.standoutNote }}</blockquote>
        {% endif %}

        {% if book.yearPub %}<div class="rrow"><span class="k">Published</span><span>{{ book.yearPub }}</span></div>{% endif %}
        {% if book.pagesNum %}<div class="rrow"><span class="k">Pages</span><span>{{ book.pagesNum }}</span></div>{% endif %}
        {% if book.isbn %}<div class="rrow"><span class="k">ISBN</span><span>{{ book.isbn }}</span></div>{% endif %}
        <div class="rrow"><span class="k">Read</span><span>{% if book.dateRead %}{% if yearLink %}<a href="{{ yearLink }}">{{ book.dateRead | date }}</a>{% else %}{{ book.dateRead | date }}{% endif %}{% else %}<span style="color:var(--faint)">not recorded</span>{% endif %}</span></div>
      </div>
    </article>

    {# Step 2 — the connections module. Prominent, not buried: this is the reason
       {{ site.readCount }} book pages read as a library rather than as filler. #}
    <section class="pagesec" id="connections">
      <div class="section-head has-action">
        <h2>Connected to {{ connections.length }} other books</h2>
        {# Hash fragment, not a query parameter — creates no new indexable URL. #}
        {% if connections.length %}<a class="mapbtn" href="/connections#book={{ book.id }}">See the connection map <span aria-hidden="true">&rarr;</span></a>{% endif %}
      </div>
      {% if connections.length %}
      <div class="cardlist">
        {% for c in connections %}
        <a class="pickcard" href="{{ c.book.href }}">
          <span class="pc-cover">
            {%- if c.book.hasCover -%}<img src="/covers/{{ c.book.id }}.jpg" width="76" height="114" alt="{{ c.book.title }} by {{ c.book.author }}" loading="lazy">
            {%- else -%}<span class="pc-ph" role="img" aria-label="{{ c.book.title }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6 4h11a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 0 1 2-2z"/></svg></span>{%- endif -%}
          </span>
          <span class="pc-body">
            <span class="pc-t">{{ c.book.shortTitle }}</span>
            <span class="pc-a">{{ c.book.author }}</span>
            {% if c.book.dateRead %}<span class="pc-when">Read {{ c.book.dateRead | date }}</span>{% endif %}
            {% if c.book.teaser %}<span class="pc-note">{{ c.book.teaser }}</span>{% endif %}
          </span>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <p class="emptynote">No connections recorded for this one yet.</p>
      {% endif %}
    </section>

{% endblock %}
