{% extends "_layout.njk" %}
{% block content %}
    <div class="page-head">
      <div class="kicker">{{ copy.kicker }}</div>
      <h1>{{ copy.h1 | safe }}</h1>
      <p class="standfirst">{{ copy.standfirst | safe }}</p>
    </div>
    <div class="prose">
{{ copy.html | safe }}
    </div>

{% if picksMode == 'clusters' %}
  {% for cluster in clusters %}
    <section class="pagesec">
      <div class="section-head"><h2>{{ cluster.name }}</h2></div>
      <p class="pagesec-intro">{{ cluster.intro }}</p>
      <div class="cardlist">
        {% for book in cluster.books %}{% set teaser = book.standoutNote %}{% include "_partials/book-card.njk" %}{% endfor %}
      </div>
    </section>
  {% endfor %}
{% else %}
    <section class="pagesec">
      <div class="section-head"><h2>Standout reads</h2><span class="sub">{{ picks.length }} books</span></div>
      <p class="pagesec-intro">Drawn from the standout picks already recorded on the shelf for {{ picksYears }}. Cluster grouping and the longer notes for each are still being written.</p>
      <div class="cardlist">
        {% for book in picks %}{% set teaser = book.teaser %}{% include "_partials/book-card.njk" %}{% endfor %}
      </div>
    </section>
{% endif %}

    <section class="pagesec">
      <div class="ctabox">
        <div class="ctabox-body">
          <h2>Read something I&rsquo;d love?</h2>
          <p>Send it over. Recommendations from people who know what I have already read are how a good chunk of this shelf got here.</p>
        </div>
        <button class="ctabtn" type="button" onclick="openRec()">Recommend a book</button>
      </div>
    </section>
{% endblock %}
