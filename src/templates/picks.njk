{% extends "_layout.njk" %}
{% block content %}
    <div class="page-head">
      <h1>{{ copy.h1 | safe }}</h1>
      <p class="standfirst">{{ copy.standfirst | safe }}</p>
    </div>
    <div class="prose">
{{ copy.html | safe }}
    </div>

{# Standout reads by year, newest first. Picks are the Notion `Standout` checkbox; a
   year with none is simply not listed — there is no algorithmic stand-in. #}
{% for y in standoutYears %}
    <section class="pagesec" id="y-{{ y.year or 'undated' }}">
      <div class="section-head">
        <h2>{% if y.year %}{{ y.year }}{% else %}Undated{% endif %}</h2>
        <span class="sub">{{ y.books.length }} standout{{ "s" if y.books.length != 1 }}{% if y.year %} &middot; <a href="/{{ y.year }}">everything from {{ y.year }}</a>{% endif %}</span>
      </div>
      <div class="cardlist">
        {% for book in y.books %}{% set teaser = book.teaser %}{% include "_partials/book-card.njk" %}{% endfor %}
      </div>
    </section>
{% endfor %}

    <section class="pagesec">
      <div class="ctabox">
        <div class="ctabox-body">
          <h2>Read something I&rsquo;d love?</h2>
          <p>Send it over. Recommendations from people who know what I have already read are how a good chunk of this shelf got here.</p>
        </div>
        <button class="ctabtn" type="button" onclick="openRec()">Recommend a book</button>
      </div>
    </section>
{% endblock %}
