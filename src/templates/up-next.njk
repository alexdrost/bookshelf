{% extends "_layout.njk" %}
{% block content %}
    <div class="page-head">
      <div class="kicker">{{ copy.kicker }}</div>
      <h1>{{ copy.h1 | safe }}</h1>
      <p class="standfirst">{{ copy.standfirst | safe }}</p>
    </div>
    <div class="prose">
{{ copy.html | safe }}
    </div>

    {# One list, one source: every public book whose Shelf is `currently-reading`.
       No derived buckets — Notion has no property that could ever fill them. #}
    <section class="pagesec">
      <div class="section-head"><h2>On the desk right now</h2><span class="sub">{{ currentlyReading.length }}</span></div>
      {% if currentlyReading.length %}
        <div class="cardlist">
          {% for book in currentlyReading %}{% set teaser = book.teaser %}{% include "_partials/book-card.njk" %}{% endfor %}
        </div>
      {% else %}
        <p class="emptynote">Nothing open at the moment &mdash; everything finished is in <a href="/library">the library</a>.</p>
      {% endif %}
    </section>
{% endblock %}
