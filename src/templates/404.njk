{% extends "_layout.njk" %}
{% block content %}
  <div class="nf">
    <div class="page-head">
      {# A toppled book on a shelf, in the theme colours. Decorative. #}
      <div class="nf-art" aria-hidden="true">
        <svg viewBox="0 0 340 120" xmlns="http://www.w3.org/2000/svg">
          <rect x="6" y="106" width="328" height="8" rx="2" fill="#c9b99a"/>
          <rect x="6" y="113" width="328" height="3" rx="1.5" fill="#b3a27f"/>
          <rect x="22" y="30" width="22" height="76" rx="2" fill="#2f6db3"/>
          <rect x="46" y="40" width="18" height="66" rx="2" fill="#c38a0e"/>
          <rect x="66" y="24" width="24" height="82" rx="2" fill="#00927a"/>
          <rect x="92" y="44" width="16" height="62" rx="2" fill="#9254c9"/>
          <rect x="110" y="34" width="20" height="72" rx="2" fill="#b92d58"/>
          <rect x="24" y="44" width="18" height="3" fill="#fff" opacity=".55"/>
          <rect x="68" y="38" width="20" height="3" fill="#fff" opacity=".55"/>
          <rect x="112" y="48" width="16" height="3" fill="#fff" opacity=".55"/>
          {# the gap where it fell from, and the book itself lying on its side #}
          <rect x="132" y="34" width="22" height="72" rx="2" fill="none" stroke="#b3a27f" stroke-width="1.5" stroke-dasharray="4 4"/>
          <g transform="translate(176 106) rotate(-8)">
            <rect x="0" y="-22" width="78" height="22" rx="2" fill="#d9582c"/>
            <rect x="10" y="-13" width="40" height="3" fill="#fff" opacity=".6"/>
          </g>
          <rect x="270" y="38" width="20" height="68" rx="2" fill="#0f8fb8"/>
          <rect x="292" y="28" width="22" height="78" rx="2" fill="#7d9a12"/>
          <rect x="316" y="46" width="14" height="60" rx="2" fill="#9a5b22"/>
        </svg>
      </div>
      <h1>That page isn&rsquo;t on the shelf</h1>
      <p class="standfirst">The link may be old, or the book may not be published here.</p>
    </div>

    {# Search opens the site-wide search with the query filled in. Without JavaScript it
       falls back to the library. #}
    <form class="nf-search" action="/library" method="get" onsubmit="return nfSearch(event)" role="search">
      <input id="nfQ" name="q" type="search" placeholder="Search the library&hellip;" autocomplete="off" aria-label="Search the library">
      <button class="browse-all" type="submit">Search</button>
    </form>

    {% if nfCovers.length %}
    <div class="section-head"><h2>Maybe you were after one of these</h2></div>
    {# Eighteen candidates are rendered; a small script shows six at random on every visit.
       Without JavaScript the first six show. #}
    <div class="nf-covers" id="nfCovers">
      {% for b in nfCovers %}
      <a href="{{ b.href }}"{% if loop.index > 6 %} hidden{% endif %}>
        <div class="cover"><img src="/covers/{{ b.id }}.jpg" width="132" height="198" alt="{{ b.title }} by {{ b.author }}" loading="lazy"></div>
        <div class="t">{{ b.shortTitle }}</div>
      </a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="prose" style="margin-top:26px">
      <p>Or try <a href="/">the shelf itself</a>, <a href="/recommendations">the recommendations</a>, or <a href="/about">who is behind this</a>.</p>
    </div>
  </div>
{% endblock %}
{% block scripts %}
<script>
function nfSearch(e){
  if(typeof openSearch!=='function')return true;
  e.preventDefault();
  var q=document.getElementById('nfQ').value;openSearch();
  var i=document.getElementById('searchInput');if(i){i.value=q;i.dispatchEvent(new Event('input'));}
  return false;
}
(function(){var g=document.getElementById('nfCovers');if(!g)return;var a=[].slice.call(g.children);
for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}
a.forEach(function(el,k){el.hidden=k>=6;g.appendChild(el);});})();
</script>
{% endblock %}
