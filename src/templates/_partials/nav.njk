{# Primary nav. Desktop: Library · Themes · Timeline · Up Next · Explore ▾ · About · Search.
   Mobile: the same, with Explore as a labelled group that also carries Recommendations.
   NAV and navHere() live in tools/build.mjs. Explore is a <details>, so it opens and
   closes with no JavaScript; app.js only adds close-on-outside-click and Escape.
   The logo always goes to /. No first-visit detection: it would need browser storage and
   would surprise returning visitors. #}
<nav>
  <div class="nav-in">
    <a class="brand" href="/" title="Back to the shelf" style="text-decoration:none">
      <svg class="logo" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="8" y="9" width="9" height="23" rx="1.5" fill="#2e6fb5"/>
        <rect x="17.5" y="11" width="8" height="21" rx="1.5" fill="#5b97d4"/>
        <rect x="25" y="8" width="8" height="24" rx="1.5" transform="rotate(7 29 20)" fill="#2f9e6b"/>
      </svg><span class="bt">Alex&rsquo;s Bookshelf</span>
    </a>
    {% for item in nav %}
    {%- if item.explore %}
    <details class="tabmenu" id="exploreMenu">
      <summary class="tab{% if navHere(page.path, item) %} here{% endif %}">{{ item.label }}<svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
      <div class="tabmenu-pop">
        {% for x in item.items %}{% if not x.mobileOnly %}<a class="tabmenu-link{% if navHere(page.path, x) %} here{% endif %}" href="{{ x.path }}">{{ x.label }}</a>{% endif %}{% endfor %}
      </div>
    </details>
    {%- else %}
    <a class="tab{% if navHere(page.path, item) %} here{% endif %}" href="{{ item.path }}">{{ item.label }}</a>
    {%- endif %}
    {%- endfor %}
    <button class="themebtn" type="button" onclick="toggleTheme()" aria-label="Switch between light and dark mode" title="Light / dark"><svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
    <button class="searchbtn" id="searchBtn" aria-label="Search the library" onclick="openSearch()"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>Search</span></button>
    <button class="navtoggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="navMenu">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
  <div class="navmenu" id="navMenu">
    {% for item in nav %}
    {%- if item.explore %}
    <div class="navgroup" role="group" aria-labelledby="navGroupExplore">
      <div class="navgroup-k" id="navGroupExplore">{{ item.label }}</div>
      {% for x in item.items %}<a class="navlink sub{% if navHere(page.path, x) %} active{% endif %}" href="{{ x.path }}">{{ x.label }}</a>{% endfor %}
    </div>
    {%- else %}
    <a class="navlink{% if navHere(page.path, item) %} active{% endif %}" href="{{ item.path }}">{{ item.label }}</a>
    {%- endif %}
    {%- endfor %}
    <button class="navtheme" type="button" onclick="toggleTheme()"><span class="themebtn" aria-hidden="true"><svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span><span class="navtheme-l">Light / dark</span></button>
    <div class="navmenu-sep"></div>
    <button class="navrec" type="button" onclick="openRec()">Recommend a book</button>
    <div class="navsocials">
      <a class="navsocial" href="https://www.goodreads.com/alex-drost" target="_blank" rel="noopener noreferrer">Follow Alex on Goodreads</a>
      <a class="navsocial" href="https://www.linkedin.com/in/adrost/" target="_blank" rel="noopener noreferrer">Connect with Alex on LinkedIn</a>
    </div>
  </div>
</nav>
