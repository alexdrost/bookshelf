{% extends "_layout.njk" %}
{% block content %}
    <div class="page-head">
      <h1>Reading over time</h1>
      <p class="standfirst">Books finished each year since {{ yearIndex[0].year }}. Longest run: {{ streaks.longestStreak }} consecutive months with a finish.</p>
    </div>


    {# Trend by month moved to /analytics (Phase 1, Nov 2026). This page is the
       year-level view: trend by year, then each year in review. #}
    <p class="pagesec-intro">The {{ preFloor }} books read before {{ yearIndex[0].year }} and the {{ undated }} with no recorded date are still in <a href="/library">the library</a>, on their theme pages, and in the <a href="/connections">connection map</a>. The month-by-month trend is on <a href="/analytics#trend-by-month">Analytics</a>.</p>

    <div class="panel">
      <div class="panel-head"><h3>Trend by year</h3>
        <div class="seg-toggle" id="tyToggle"><button class="on" data-m="books">Books</button><button data-m="pages">Pages</button></div>
      </div>
      <p class="cap">How the mix shifts year to year. <span class="hint">Hover any segment for the books behind it &mdash; click one to open it.</span></p>
      {# Full width. The 300px side panel this replaced took a third of the chart and
         sat empty until you hovered; the books now come to the cursor instead, in the
         same popover the month chart on /analytics uses. #}
      <div class="stack-wrap" id="themeStack"></div>
      <div class="tlegend" id="stackLegend"></div>
      <p class="cap" style="margin:14px 0 0"><span id="undatedNote"></span></p>
    </div>

    <div class="panel yir-panel">
      <h3>Years in review</h3>
      <p class="cap">A snapshot of each full year &mdash; headline numbers, the themes that defined it, and the books that stood out.</p>
      <div class="yir-wrap" id="yearReview"></div>
    </div>
{% endblock %}
{% block scripts %}<script src="{{ asset('/assets/js/analytics.js') }}" defer></script>
<script defer>window.addEventListener('load',function(){loadBooks().then(function(){renderTime();window.addEventListener('themechange',renderTime);});});</script>{% endblock %}
